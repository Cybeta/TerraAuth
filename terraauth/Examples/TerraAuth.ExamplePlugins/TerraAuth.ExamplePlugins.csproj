<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TerraAuth.ExamplePlugins</RootNamespace>
  </PropertyGroup>

  <!-- 仅编译期引用核心：运行时 TerraAuth.dll 由服务端进程已加载的程序集提供，不复制到输出 -->
  <ItemGroup>
    <ProjectReference Include="..\..\TerraAuth.csproj" Private="false" />
  </ItemGroup>

  <!-- 构建后把插件 DLL 复制到服务端 plugins/ 目录（PluginLoader 从此目录发现插件） -->
  <Target Name="CopyToServerPlugins" AfterTargets="Build">
    <PropertyGroup>
      <ServerPluginsDir>$(MSBuildProjectDirectory)\..\..\bin\$(Configuration)\net10.0\plugins</ServerPluginsDir>
    </PropertyGroup>
    <MakeDir Directories="$(ServerPluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ServerPluginsDir)" />
    <Message Importance="high" Text="示例插件已复制到 $(ServerPluginsDir)" />
  </Target>

</Project>
